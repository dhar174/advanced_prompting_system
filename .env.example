# ==============================================================================
# Advanced Prompting System — Environment Configuration Example (No Secrets!)
# ==============================================================================
# Copy to `.env` for local live runs. NEVER commit `.env` or real API keys.

# Provider Credentials (required only for live LLM calls when OFFLINE_MODE=0)
# OPENAI_API_KEY=replace-with-your-openai-api-key

# Offline / Qualification Mode (1 disables live embeddings calls and uses seeded vectors)
OFFLINE_MODE=0

# Enforce explicit provider readiness check before executing runs (1 = fail-closed without credentials)
APS_ENFORCE_PROVIDER_READY=0

# Server-Owned Model Allowlist & Defaults
APS_DEFAULT_MODEL=gpt-4o-mini
APS_ALLOWED_MODELS=gpt-4o-mini,gpt-4o,o3-mini
APS_TEMPERATURE=0.7
APS_TIMEOUT_SECONDS=120
APS_MAX_CALLS=40

# HTTP / GraphQL Hardening Controls
# Comma-separated browser origins allowed by CORS (defaults to loopback origins only)
# APS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
# Optional Bearer token required on /graphql when set
# APS_API_TOKEN=replace-with-long-random-token
# Fixed-window per-IP rate limit on /graphql requests per minute (default: 60; 0 disables)
APS_RATE_LIMIT_RPM=60
# Maximum POST request body bytes (default: 1048576 = 1 MiB)
APS_MAX_CONTENT_LENGTH=1048576
# Set to 1 ONLY in trusted local development if you want GraphiQL GET UI enabled
APS_ENABLE_GRAPHIQL=0

# Persistent Feedback Log Location (optional)
# APS_LOG_FILE=logs/conversation_logs.json

# Server Network Binding
PORT=8000
HOST=0.0.0.0
